# Copy to .env and fill in.
#
# Readwise access token — get one at https://readwise.io/access_token
READWISE_TOKEN=

# Host port to expose the OPDS server on (the container always listens on 8080).
# 7323 = "READ" on a phone keypad.
HOST_PORT=7323

# HTTP Basic auth — REQUIRED if you expose this beyond your LAN (tunnel/Funnel/
# reverse proxy). Leave unset for LAN-only. Crosspoint's OPDS setup has
# Username/Password fields, so these work on-device.
# OPDS_AUTH_USER=readloop
# OPDS_AUTH_PASS=change-me
